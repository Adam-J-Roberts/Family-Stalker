# Copy to .env in this directory. Do not commit the populated file.
# Optional starting URL; it can also be entered on the sign-in screen.
STALKER_SERVER_URL=
# Blank = MapLibre with OpenStreetMap tiles. Nonempty = Google Maps Android SDK.
# This is the Android key, not the browser key in Docker's .env.
STALKER_GOOGLE_MAPS_ANDROID_API_KEY=
